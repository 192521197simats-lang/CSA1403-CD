#include <stdio.h>

int main() {
    char s[500];
    int i = 0;

    printf("Enter an expression: ");
    fgets(s, sizeof(s), stdin);

    while (s[i] != '\0') {
        switch (s[i]) {
            case '+':
            case '-':
            case '*':
            case '/':
                printf("%c is an arithmetic operator\n", s[i]);
                break;
        }
        i++;
    }

    return 0;
}
