#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char s[500], token[100];
    int i = 0, j;

    printf("Enter an expression: ");
    fgets(s, sizeof(s), stdin);

    while (s[i] != '\0') {
        if (isspace(s[i])) {
            i++;
        }
        else if (isalpha(s[i]) || s[i] == '_') {
            j = 0;
            while (isalnum(s[i]) || s[i] == '_')
                token[j++] = s[i++];
            token[j] = '\0';
            printf("Identifier: %s\n", token);
        }
        else if (isdigit(s[i])) {
            j = 0;
            while (isdigit(s[i]) || s[i] == '.')
                token[j++] = s[i++];
            token[j] = '\0';
            printf("Constant: %s\n", token);
        }
        else if (strchr("+-*/%=<>!&|", s[i])) {
            printf("Operator: %c\n", s[i]);
            i++;
        }
        else {
            i++;
        }
    }

    return 0;
}
